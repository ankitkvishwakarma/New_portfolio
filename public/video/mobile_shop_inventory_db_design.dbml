// Mobile Shop Management — Inventory DB Design
// MySQL-oriented DBML for visualization in drawDB

Table brands {
  id int [pk, increment]
  name varchar(100) [not null, unique]
  created_at datetime
}

Table categories {
  id int [pk, increment]
  name varchar(100) [not null, unique]
  created_at datetime
}

Table products {
  id int [pk, increment]
  sku varchar(50) [not null, unique]
  name varchar(150) [not null]
  brand_id int [not null]
  category_id int [not null]
  model_number varchar(100)
  is_serialized boolean [not null, default: true]
  created_at datetime
}

Table locations {
  id int [pk, increment]
  name varchar(100) [not null]
  address varchar(255)
}

Table inventory_items {
  id bigint [pk, increment]
  product_id int [not null]
  location_id int [not null]
  imei_1 varchar(20) [unique]
  imei_2 varchar(20) [unique]
  serial_number varchar(100) [unique]
  purchase_cost decimal(12,2)
  status varchar(30) [not null, default: 'IN_STOCK']
  created_at datetime
  updated_at datetime
}

Table stock {
  id bigint [pk, increment]
  product_id int [not null]
  location_id int [not null]
  quantity int [not null, default: 0]
  updated_at datetime

  Indexes {
    (product_id, location_id) [unique]
  }
}

Table stock_movements {
  id bigint [pk, increment]
  product_id int [not null]
  location_id int [not null]
  inventory_item_id bigint
  movement_type varchar(30) [not null]
  quantity int [not null]
  reference_type varchar(30)
  reference_id bigint
  notes varchar(255)
  created_at datetime
}

Ref: products.brand_id > brands.id
Ref: products.category_id > categories.id
Ref: inventory_items.product_id > products.id
Ref: inventory_items.location_id > locations.id
Ref: stock.product_id > products.id
Ref: stock.location_id > locations.id
Ref: stock_movements.product_id > products.id
Ref: stock_movements.location_id > locations.id
Ref: stock_movements.inventory_item_id > inventory_items.id
